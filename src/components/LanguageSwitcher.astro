---
const { lang = 'en' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const enHref = `${base}/`;
const esHref = `${base}/es/`;
const enFlagSrc = `${base}/flags/us.svg`;
const esFlagSrc = `${base}/flags/es.svg`;
---
<div class="lang-switcher" role="group" aria-label="Language selector">
  <a
    href={enHref}
    class:list={['lang-btn', { 'is-active': lang === 'en' }]}
    aria-label="Switch to English"
    aria-current={lang === 'en' ? 'page' : undefined}
  >
    <img class="flag" src={enFlagSrc} alt="" aria-hidden="true" />
  </a>
  <a
    href={esHref}
    class:list={['lang-btn', { 'is-active': lang === 'es' }]}
    aria-label="Cambiar a Español"
    aria-current={lang === 'es' ? 'page' : undefined}
  >
    <img class="flag" src={esFlagSrc} alt="" aria-hidden="true" />
  </a>
</div>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 16px;
    border: 1px solid var(--p-nav-border, rgba(120,140,170,0.18));
    background: var(--p-nav-pill-bg, rgba(255,255,255,0.65));
    backdrop-filter: blur(10px);
    box-shadow: var(--p-nav-pill-shadow, 0 2px 8px rgba(100,116,139,0.08));
    min-width: 0;
    font-family: "Rajdhani", sans-serif;
  }

  .lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 7px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--p-text-subtle, #475569);
    text-decoration: none;
    line-height: 1;
    min-height: 29px;
    min-width: 38px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .flag {
    display: block;
    width: 18px;
    height: 13px;
    border-radius: 3px;
    border: 1px solid rgba(15, 23, 42, 0.18);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.15);
    overflow: hidden;
    flex-shrink: 0;
  }

  .lang-btn:hover {
    background: var(--p-nav-hover-bg, rgba(255,255,255,0.9));
    border-color: var(--p-nav-pill-border, transparent);
    color: var(--p-text, #1f2a37);
    box-shadow: var(--p-nav-pill-hover-shadow, 0 2px 6px rgba(100,116,139,0.10));
    transform: translateY(-1px);
  }

  .lang-btn:focus-visible {
    outline: 2px solid var(--p-accent, #2f6db2);
    outline-offset: 2px;
  }

  .lang-btn.is-active {
    background: var(--p-accent, #5a95c1);
    border-color: var(--p-accent, #5a95c1);
    box-shadow: var(--p-nav-active-shadow, 0 4px 10px rgba(90,149,193,0.30));
    pointer-events: none;
  }

  html.light .lang-btn.is-active {
    background: var(--p-nav-active-bg, linear-gradient(180deg, #1f5f8f 0%, #184c73 100%));
    border-color: var(--p-nav-active-border, rgba(24,76,115,0.44));
    box-shadow: var(--p-nav-active-shadow, 0 8px 18px rgba(37,87,146,0.28));
  }

  html.light .lang-btn.is-active:hover {
    background: linear-gradient(180deg, #2d6f98 0%, #1f5f8f 100%);
  }

  @media (max-width: 480px) {
    .lang-btn {
      min-width: 36px;
      padding: 5px 6px;
    }

    .flag {
      width: 16px;
      height: 12px;
    }
  }
</style>

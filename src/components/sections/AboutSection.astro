---
import IconInfo from '../IconInfo.astro';
import { withBase } from '../../utils/withBase';
import 'aos/dist/aos.css';
const { about } = Astro.props;
---
<style>
  .about-shell {
    background: var(--p-about-shell-bg);
    border-color: var(--p-about-shell-border);
    box-shadow: var(--p-card-shadow), var(--p-card-inset-highlight);
  }

  .about-image {
    border-color: rgba(98,155,182,0.4);
    box-shadow: var(--p-card-shadow), var(--p-card-inset-highlight);
  }

  .about-image-overlay {
    background: var(--p-about-image-overlay);
  }

  .about-status {
    background: var(--p-about-status-bg);
    border-color: var(--p-about-status-border);
  }

  .about-availability-text {
    background: var(--p-about-availability-chip-bg);
    border: 1px solid var(--p-about-availability-chip-border);
    border-radius: 999px;
    padding: 1px 10px;
    line-height: 1.4;
    color: #000000;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .about-status:hover .about-availability-text,
  .about-status:focus-within .about-availability-text {
    transform: translateY(-1px);
  }

  .about-hire-link {
    background: var(--p-about-hire-button-bg);
    color: var(--p-nav-active-text);
    box-shadow: var(--p-nav-active-shadow), inset 0 1px 0 rgba(255,255,255,0.16);
    transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .about-hire-link:hover {
    background: var(--p-about-hire-button-hover-bg);
    transform: translateY(-1px);
    box-shadow: var(--p-nav-pill-hover-shadow), inset 0 1px 0 rgba(255,255,255,0.16);
  }

  .about-hire-link:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--p-about-hire-button-focus-ring),
      var(--p-nav-pill-hover-shadow),
      inset 0 1px 0 rgba(255,255,255,0.16);
  }

  @media (min-width: 769px) {
    .about-status {
      width: fit-content;
      max-width: 100%;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .about-copy {
      text-align: justify;
    }

    .about-media {
      align-self: center;
      width: min(100%, 353px);
    }

    .about-image,
    .about-image-overlay {
      max-width: 100%;
    }
  }
</style>

<section id="about" data-aos="fade-up" data-aos-delay="300" class="px-4 py-8" style="background: var(--p-resume-section-bg);">
  <div class="max-w-[1155px] mx-auto">
    <div class="about-shell relative w-full rounded-[5px] overflow-hidden border">
      <div class="p-7 flex flex-col lg:flex-row gap-8">
        <div class="flex-1 flex flex-col gap-6">
          <div class="w-fit gap-[9px] h-11 flex items-center rounded-[50px] border px-4" style="background: var(--p-section-badge-bg); border-color: var(--p-section-badge-border);">
            <IconInfo class="w-4 h-4" style="color: var(--p-text);" />
            <span class="font-[Rajdhani] font-bold text-base leading-[26px] whitespace-nowrap" style="color: var(--p-text);">
              {about.badge}
            </span>
          </div>

          <div class="about-copy prose prose-lg w-full max-w-none font-[Rajdhani] font-normal text-base text-justify leading-[26px] whitespace-pre-line" style="color: var(--p-text-muted);">
            {about.text}
          </div>

          <div class="about-status self-start max-w-full gap-[7px] px-3.5 py-2 rounded-[50px] border flex items-center mt-auto">
            <a
              href="#contact"
              class="about-hire-link flex flex-col w-[68px] items-center justify-center p-2.5 h-[26px] rounded-[40px] focus:outline-none focus:ring-2 focus:ring-[var(--p-accent)]"
            >
              <span class="font-[Rajdhani] font-bold text-[10px] leading-[26px] whitespace-nowrap" style="color: var(--p-nav-active-text);">
                {about.hireCtaLabel}
              </span>
            </a>

            <span class="font-[Rajdhani] font-bold text-xs text-left whitespace-nowrap" style="color: var(--p-accent-dark);">
              {about.availabilityText}
            </span>
          </div>
        </div>

        <div class="about-media flex-shrink-0 relative">
          <img
            class="about-image w-full max-w-[353px] h-auto border rounded-[10px] object-cover"
            alt="About image"
            src={withBase(about.image)}
            loading="lazy"
          />
          <div class="about-image-overlay absolute inset-0 rounded-[10px] max-w-[353px] pointer-events-none"></div>
        </div>
      </div>
    </div>
  </div>
</section>
